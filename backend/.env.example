# Copy this file to .env and fill in your real Neon connection string.
# Never commit the real .env — it's already in .gitignore.

# Get this from your Neon project dashboard. Note the driver in the scheme:
# SQLAlchemy needs "postgresql+psycopg://", not just "postgresql://".
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-real-random-secret
JWT_EXPIRY_DAYS=30
